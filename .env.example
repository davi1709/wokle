# ─────────────────────────────────────────────────────────────
# WOKLE — environment variables
# Copy this file to .env.local and fill in what you need.
# PHASE 1 (the playable MVP) needs NONE of these: it runs on demo data.
# Never commit .env.local. Never prefix secrets with NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────
# IANA timezone that defines when "a new day" starts for everyone.
WOKLE_TIMEZONE=America/Sao_Paulo
# First day of WOKLE #1 (YYYY-MM-DD, in the timezone above).
WOKLE_LAUNCH_DATE=2026-11-04
# Public URL, used in the share text and the social preview image
# (no trailing slash). In production: https://wokle.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "Report an error" link. Set ONE of these (otherwise the link is hidden):
#  - an e-mail address: opens the reader's mail app with a pre-filled subject
NEXT_PUBLIC_CONTACT_EMAIL=
#  - or your GitHub repo URL: opens a pre-filled GitHub issue
#    e.g. https://github.com/your-user/wokle
NEXT_PUBLIC_REPO_URL=

# ── Supabase (Phase 2+) ──────────────────────────────────────
# Where: https://supabase.com → New project → Project Settings → API
# Run db/schema.sql in the SQL Editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Used by the API routes and the daily pipeline.
SUPABASE_SERVICE_ROLE_KEY=

# ── LLM provider (Phase 2) ───────────────────────────────────
# Provider-agnostic: the pipeline will talk to one adapter file.
# Where (Anthropic): https://console.anthropic.com → API keys
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_DRAFT=
LLM_MODEL_VERIFY=

# ── Automation (Phase 2/4) ───────────────────────────────────
# Shared secret that the scheduler (GitHub Actions / Vercel Cron) sends
# to /api/cron/* endpoints. Generate with: openssl rand -hex 32
CRON_SECRET=
# AUTO_PUBLISH publishes only VERIFIED content automatically.
# REVIEW holds everything until you approve it in the admin dashboard.
WOKLE_PUBLISH_MODE=AUTO_PUBLISH

# ── Admin (Phase 4) ──────────────────────────────────────────
# Comma-separated e-mails allowed into /admin (Supabase Auth).
ADMIN_EMAILS=

# ── Notifications (Phase 4, optional) ────────────────────────
# Where failures are reported (e.g. Resend, a Discord webhook, etc.).
ALERT_WEBHOOK_URL=
